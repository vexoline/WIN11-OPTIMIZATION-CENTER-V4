<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Win11OptimizationCenter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Win11OptimizationCenter">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#FFE8F0FA" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF5F8FC" />
                    <SolidColorBrush x:Key="AppSurfaceStrongBrush" Color="#FFD7E4F3" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FF10243D" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FF354D68" />
                    <SolidColorBrush x:Key="AppIconBrush" Color="#FF0067C0" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FFD5E0EE" />
                    <SolidColorBrush x:Key="AppLogBackgroundBrush" Color="#FFEAF0F8" />
                    <SolidColorBrush x:Key="AppLogForegroundBrush" Color="#FF132239" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#FF071426" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF102542" />
                    <SolidColorBrush x:Key="AppSurfaceStrongBrush" Color="#FF16365D" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFE7F0FC" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FFE6F0FC" />
                    <SolidColorBrush x:Key="AppIconBrush" Color="#FF62B6FF" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FF274466" />
                    <SolidColorBrush x:Key="AppLogBackgroundBrush" Color="#FF07111E" />
                    <SolidColorBrush x:Key="AppLogForegroundBrush" Color="#FFD9F2FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppSurfaceStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AppIconBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppLogBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppLogForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
