<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Win11OptimizationCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Win11OptimizationCenter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows 11 Network &amp; USB Optimizer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="TitleBarSurface"
            Grid.Row="0"
            Height="48"
            Background="Transparent">
            <TitleBar
                x:Name="AppTitleBar"
                Title="Windows 11 Network &amp; USB Optimizer"
                Subtitle="USB • Wi-Fi • Ethernet • Power management"
                Height="48"
                FontSize="17"
                FontWeight="SemiBold"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
        </Border>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
